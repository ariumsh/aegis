# ─────────────────────────────────────────────
#  Discord
# ─────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
PUBLIC_KEY=your_public_key_here

# ─────────────────────────────────────────────
#  Bot settings
# ─────────────────────────────────────────────
PREFIX=a!
NODE_ENV=development

# Comma-separated guild IDs to register slash commands to while developing.
# Commands appear instantly there; leave empty to register globally (which can
# take up to an hour to propagate). The bot must be a member of these guilds.
DEVELOPMENT_GUILD_IDS=

# ─────────────────────────────────────────────
#  Stats API
# ─────────────────────────────────────────────
API_PORT=4000
# Leave empty to expose /stats without auth (fine locally).
# Set a value and the endpoint requires: Authorization: Bearer <token>
STATS_API_TOKEN=

# Floor of the member counter loop, in ms. Minimum 5000, default 5000.
# Voice does not wait for this — it redraws off the gateway event, within about
# a second and a half. The loop only drives the count refresh and catches
# anything the event path missed. A pass where none of the three numbers changed
# makes no API call at all.
COUNTER_INTERVAL_MS=

# How often online/total are re-fetched from Discord, in ms. Minimum 15000,
# default 60000, and never faster than COUNTER_INTERVAL_MS. These are Discord's
# approximate counts, which it only recomputes every few minutes — asking more
# often costs a request and returns the same number.
COUNTER_COUNTS_INTERVAL_MS=

# ─────────────────────────────────────────────
#  PostgreSQL
# ─────────────────────────────────────────────
# Credentials docker compose uses to provision the container
POSTGRES_USER=admin
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=aegis_dev

# Connection string used from the HOST (prisma studio, migrate, generate).
# Host port is 5433. The bot container uses postgres:5432 instead — compose
# overrides DATABASE_URL for that service, so don't change this to match it.
DATABASE_URL=postgresql://admin:secure_password@localhost:5433/aegis_dev

# ─────────────────────────────────────────────
#  Redis
# ─────────────────────────────────────────────
# Host port is 6380. The bot container uses redis:6379 (overridden by compose).
REDIS_URL=redis://localhost:6380
